# Copy to `.env` in the repo root to override docker-compose defaults.
# docker compose automatically reads a root-level `.env`.

# --- Database ---
DB_DATABASE=ecom
DB_USERNAME=root
DB_PASSWORD=secret
DB_FORWARD_PORT=3306

# --- Redis ---
REDIS_FORWARD_PORT=6379

# --- Laravel ---
APP_ENV=local
APP_DEBUG=true

# --- Published ports (host side) ---
BACKEND_PORT=8000
MAINPAGE_PORT=3000
ADMIN_PORT=3001

# --- Frontend runtime config ---
# Relative API base: the Nuxt server proxies /api and /storage to the backend
# (nginx) service, so it works for both SSR and the browser. Leave as /api.
ADMIN_API_BASE=/api
MAINPAGE_API_BASE=/api
STOREFRONT_DOMAIN=selluee.test
DEFAULT_VENDOR_ID=
GOOGLE_CLIENT_ID=
